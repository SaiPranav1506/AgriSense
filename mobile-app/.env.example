# Backend base URL for the AgriSense Flask server.
# Use ONE of these depending on how you run the demo:
#
# 1. Physical Android phone (iQOO 15) on the SAME Wi-Fi as your PC:
#    -> use your PC's local network IP (find it with `ipconfig`, e.g. 192.168.1.5)
#EXPO_PUBLIC_API_URL=http://192.168.1.5:5000
#
# 2. Android Emulator on the same PC:
#EXPO_PUBLIC_API_URL=http://10.0.2.2:5000
#
# 3. Web / quick local test:
#EXPO_PUBLIC_API_URL=http://localhost:5000
#
# 4. A deployed server:
#EXPO_PUBLIC_API_URL=https://your-server.example.com

EXPO_PUBLIC_API_URL=http://localhost:5000
