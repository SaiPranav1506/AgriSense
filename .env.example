# Flask configuration
FLASK_DEBUG=0
PORT=5000

# CORS - comma-separated allowed origins
# In production, set this to your Vercel frontend URL
CORS_ORIGINS=http://localhost:9999,http://localhost:5173

# ── Conversational agent provider ──
# The agent prefers NVIDIA NIM when NVIDIA_API_KEY is set; otherwise it
# falls back to Anthropic. Set at least one.

# NVIDIA NIM (OpenAI-compatible endpoint)
# Get a key at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Must be a tool-calling capable model. Verified working:
#   nvidia/nemotron-3.5-lightning-30b-a3b (fast, default)
#   nvidia/nemotron-3-super-120b-a12b     (higher quality)
#   openai/gpt-oss-20b
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Anthropic API key (fallback provider)
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...